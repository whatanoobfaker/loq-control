    def refresh_profiles(self):
        cur = lc.get_profile()
        self.combo.blockSignals(True)
        self.combo.clear()
        for c in lc.profile_choices():
            self.combo.addItem(lc.PROFILE_LABELS.get(c, c.title()), c)
        i = self.combo.findData(cur)
        self.combo.setCurrentIndex(max(i, 0))
        self.combo.blockSignals(False)
        self.load()

    def profile(self):
        return self.combo.currentData()

    def firmware_curve(self, prof):
        fw = lc.load_firmware_curves().get(prof)
        if fw:
            return fw
        entry = self.win.cfg.get("curves", {}).get(prof, {})
        if prof == lc.get_profile() and not entry.get("enabled"):
            return lc.read_curve()
        return None

    def load(self):
        prof = self.profile()
        if not prof:
            return
        entry = self.win.cfg.get("curves", {}).get(prof)
        fw = self.firmware_curve(prof)
        self.editor.ref = fw
        pts = entry["points"] if entry and entry.get("points") else (fw or lc.read_curve())
        self.enabled.setChecked(bool(entry and entry.get("enabled")))
        if pts:
            self.editor.set_points(pts)
            self.sync_table()

    def sync_table(self):
        self._sync = True
        for row, pt in zip(self.spins, self.editor.points):
            for sp, v in zip(row, pt):
                sp.setValue(v)
        self._sync = False

    def from_table(self):
        if self._sync:
            return
        pts = [[sp.value() for sp in row] for row in self.spins]
        if self.link.isChecked():
            for i, row in enumerate(self.spins):
                if row[3].hasFocus():
                    pts[i][2] = pts[i][3]
                else:
                    pts[i][3] = pts[i][2]
            self._sync = True
            for row, pt in zip(self.spins, pts):
                row[2].setValue(pt[2])
                row[3].setValue(pt[3])
            self._sync = False
        self.editor.set_points(pts)

    def preset(self, name):
        rpm = PRESETS[name]
        self.editor.set_points([[PRESET_T[i], PRESET_G[i], rpm[i], rpm[i]] for i in range(lc.CURVE_POINTS)])
        self.sync_table()
        self.enabled.setChecked(True)

    def firmware_preset(self):
        fw = self.firmware_curve(self.profile())
        if fw:
            self.editor.set_points(fw)
            self.sync_table()
        else:
            self.win.status("The firmware curve for this mode is captured the first time you use the mode")

    def apply(self):
        pts = [list(p) for p in self.editor.points]
        err = lc.validate_curve(pts)
        if err:
            QMessageBox.warning(self.widget, "Invalid curve", err)
            return
        prof = self.profile()
        self.win.cfg.setdefault("curves", {})[prof] = {"enabled": self.enabled.isChecked(), "points": pts}
        self.win.save()
        if prof != lc.get_profile():
            self.win.status("Saved. It applies when you switch to %s" % self.combo.currentText())
            return
        target = pts if self.enabled.isChecked() else self.firmware_curve(prof)
        if not target:
            self.win.status("Saved")
            return
        try:
            retry(lc.write_curve, target)
            self.win.status("Fan curve applied" if self.enabled.isChecked() else "Firmware curve restored")
        except OSError as e:
            QMessageBox.warning(self.widget, "Fan curve rejected", str(e))

    def revert(self):
        prof = self.profile()
        entry = self.win.cfg.setdefault("curves", {}).get(prof)
        if entry:
            entry["enabled"] = False
        self.win.save()
        fw = self.firmware_curve(prof)
        self.enabled.setChecked(False)
        if fw:
            self.editor.set_points(fw)
            self.sync_table()
            if prof == lc.get_profile():
                try:
                    retry(lc.write_curve, fw)
                except OSError as e:
                    QMessageBox.warning(self.widget, "Fan curve rejected", str(e))
        self.win.status("Using the firmware curve")

    def update(self, s):
        self.editor.live_temp = s["cpu"]
        if self.widget.isVisible():
            self.editor.update()


class DevicePage:
    def __init__(self, win):
        self.win = win
        self.widget, lay = page("Device", "Battery, keyboard, display and lighting. Settings are remembered and restored at boot.")
        self.switches = {}
        groups = {"battery": "Battery", "input": "Keyboard and touchpad", "display": "Display and camera"}
        for key, title in groups.items():
            items = [t for t in lc.TOGGLES if t[4] == key and os.path.exists(os.path.join(t[1], t[0]))]
            if not items:
                continue
            lay.addWidget(section(title))
            box = QFrame()
            box.setObjectName("card")
            v = QVBoxLayout(box)
            v.setContentsMargins(16, 8, 16, 8)
            for i, (name, _base, label, desc, _g) in enumerate(items):
                if i:
                    line = QFrame()
                    line.setObjectName("sep")
                    line.setFixedHeight(1)
                    v.addWidget(line)
                h = QHBoxLayout()
                t = QVBoxLayout()
                t.setSpacing(0)
                a = QLabel(label)
                a.setObjectName("rowTitle")
                b = QLabel(desc)
                b.setObjectName("hint")
                t.addWidget(a)
                t.addWidget(b)
                h.addLayout(t, 1)
                sw = Switch()
                sw.toggled.connect(lambda on, n=name: self.toggle(n, on))
                h.addWidget(sw)
                v.addLayout(h)
                self.switches[name] = sw
            lay.addWidget(box)
        self.leds = {}
        led_list = lc.leds()
        if led_list:
            lay.addWidget(section("Lighting"))
            box = QFrame()
            box.setObjectName("card")
            g = QGridLayout(box)
            g.setContentsMargins(16, 12, 16, 12)
            seen = set()
            for row, (name, label, d) in enumerate(led_list):
                mx = lc.read_int(os.path.join(d, "max_brightness"), 1) or 1
                g.addWidget(QLabel(label), row, 0)
                if mx > 1:
                    sl = QSlider(Qt.Horizontal)
                    sl.setRange(0, mx)
                    sl.setPageStep(1)
                    sl.setTickPosition(QSlider.TicksBelow)
                    sl.valueChanged.connect(lambda v, n=name: self.led(n, v))
                    g.addWidget(sl, row, 1)
                    self.leds[name] = sl
                else:
                    sw = Switch()
                    sw.toggled.connect(lambda on, n=name: self.led(n, int(on)))
                    g.addWidget(sw, row, 1, Qt.AlignRight)
                    self.leds[name] = sw
            g.setColumnStretch(1, 1)
            lay.addWidget(box)
        lay.addStretch(1)
        self.load()

    def load(self):
        for name, sw in self.switches.items():
            v = lc.read(lc.toggle_path(name))
            sw.blockSignals(True)
            sw.setChecked(v == "1")
            sw.setEnabled(v is not None)
            sw.blockSignals(False)
        for name, w in self.leds.items():
            v = lc.read_int(os.path.join("/sys/class/leds", name, "brightness"), 0)
            w.blockSignals(True)
            if isinstance(w, QSlider):
                w.setValue(v)
            else:
                w.setChecked(v > 0)
            w.blockSignals(False)

    def toggle(self, name, on):
        try:
            retry(lc.write, lc.toggle_path(name), int(on))
        except OSError as e:
            QMessageBox.warning(self.widget, "Could not change setting", "%s: %s" % (name, e.strerror or e))
            self.load()
            return
        self.win.cfg.setdefault("toggles", {})[name] = int(on)
        other = lc.EXCLUSIVE.get(name)
        if on and other and other in self.switches:
            self.win.cfg["toggles"][other] = 0
        self.win.save()
        QTimer.singleShot(300, self.load)

    def led(self, name, value):
        try:
            lc.write(os.path.join("/sys/class/leds", name, "brightness"), value)
        except OSError as e:
            self.win.status("%s: %s" % (name, e.strerror or e))
            return
        self.win.cfg.setdefault("leds", {})[name] = value
        self.win.save()

    def update(self, s):
        pass


