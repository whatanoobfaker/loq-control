        if on:
            os.makedirs(os.path.dirname(self.AUTOSTART), exist_ok=True)
            src = "/usr/share/loq-control/loq-control-autostart.desktop"
            with open(src) as f, open(self.AUTOSTART, "w") as o:
                o.write(f.read())
        elif os.path.exists(self.AUTOSTART):
            os.remove(self.AUTOSTART)

    def refresh(self):
        def svc(name):
            try:
                return subprocess.run(["systemctl", "is-active", name], capture_output=True, text=True).stdout.strip()
            except OSError:
                return "unknown"
        vendor = lc.read("/sys/class/dmi/id/sys_vendor", "")
        product = lc.read("/sys/class/dmi/id/product_version", "")
        bios = lc.read("/sys/class/dmi/id/bios_version", "")
        drv = "loaded" if os.path.exists(os.path.join(lc.LEGION, "fancurve")) else "not loaded"
        writable = os.access(os.path.join(lc.LEGION, "fancurve"), os.W_OK)
        self.info.setText(
            "Machine: %s %s (BIOS %s)\nFan driver: %s\nBackground service (loqd): %s\n"
            "Write access: %s\nPower mode interface: %s\nSettings file: %s" % (
                vendor, product, bios, drv, svc("loqd.service"),
                "yes" if writable else "no — make sure loqd is running and you are in the '%s' group" % lc.GROUP,
                lc.profile_path(), lc.CONFIG))

    def update(self, s):
        pass


