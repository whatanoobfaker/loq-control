            self.value.setStyleSheet("color: %s" % c.name())


class Chart(QWidget):
    def __init__(self, title, series, lo, hi, unit):
        super().__init__()
        self.title, self.series, self.lo, self.hi, self.unit = title, series, lo, hi, unit
        self.data = {k: deque(maxlen=HISTORY) for k, _ in series}
        self.setMinimumHeight(170)

    def push(self, key, v):
        self.data[key].append(v)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        pal = self.palette()
        r = self.rect().adjusted(46, 26, -12, -22)
        p.setPen(pal.color(QPalette.WindowText))
        f = p.font()
        f.setBold(True)
        p.setFont(f)
        p.drawText(12, 18, self.title)
        f.setBold(False)
        p.setFont(f)
        x = self.width() - 12
        for key, label in reversed(self.series):
            vals = [v for v in self.data[key] if v is not None]
            txt = "%s %s" % (label, fmt(vals[-1], self.unit) if vals else "—")
            w = p.fontMetrics().horizontalAdvance(txt)
            x -= w
            p.setPen(SERIES[key])
            p.drawText(x, 18, txt)
            x -= 16
        hi = self.hi
        for key, _ in self.series:
            vals = [v for v in self.data[key] if v is not None]
            if vals:
                hi = max(hi, max(vals))
        lo = self.lo
        grid = QColor(pal.color(QPalette.WindowText))
        grid.setAlpha(35)
        p.setPen(QPen(grid, 1))
        steps = 4
        for i in range(steps + 1):
            y = r.bottom() - i * r.height() / steps
            p.drawLine(QPointF(r.left(), y), QPointF(r.right(), y))
            val = lo + (hi - lo) * i / steps
            lab = QColor(pal.color(QPalette.WindowText))
            lab.setAlpha(140)
            p.setPen(lab)
            p.drawText(QRectF(0, y - 8, r.left() - 6, 16), Qt.AlignRight | Qt.AlignVCenter, "%d" % val)
            p.setPen(QPen(grid, 1))
        for key, _ in self.series:
            pts = list(self.data[key])
            if len(pts) < 2:
                continue
            path = QPainterPath()
            fill = QPainterPath()
            started = False
            n = HISTORY - 1
            off = HISTORY - len(pts)
            first_x = None
            last_x = None
            for i, v in enumerate(pts):
                if v is None:
                    continue
                px = r.left() + (off + i) * r.width() / n
                py = r.bottom() - (min(max(v, lo), hi) - lo) / (hi - lo) * r.height()
                if not started:
                    path.moveTo(px, py)
                    fill.moveTo(px, r.bottom())
                    fill.lineTo(px, py)
                    first_x = px
                    started = True
                else:
                    path.lineTo(px, py)
                    fill.lineTo(px, py)
                last_x = px
            if not started:
                continue
            fill.lineTo(last_x, r.bottom())
            fill.closeSubpath()
            c = QColor(SERIES[key])
            g = QLinearGradient(0, r.top(), 0, r.bottom())
            c1 = QColor(c)
            c1.setAlpha(70)
            c2 = QColor(c)
            c2.setAlpha(0)
            g.setColorAt(0, c1)
            g.setColorAt(1, c2)
            p.fillPath(fill, QBrush(g))
            p.setPen(QPen(c, 2))
            p.drawPath(path)


class CurveEditor(QWidget):
    changed = Signal()

    TMIN, TMAX = 30, 105

    def __init__(self):
        super().__init__()
        self.points = [[0, 0, 0, 0] for _ in range(lc.CURVE_POINTS)]
        self.ref = None
        self.live_temp = None
        self.live_point = None
        self.drag = None
        self.setMinimumHeight(300)
        self.setMouseTracking(True)

    def area(self):
        return self.rect().adjusted(58, 16, -18, -34)

    def to_px(self, t, rpm):
        r = self.area()
        x = r.left() + (t - self.TMIN) / (self.TMAX - self.TMIN) * r.width()
        y = r.bottom() - rpm / lc.MAX_RPM * r.height()
        return QPointF(x, y)

    def from_px(self, pos):
        r = self.area()
        t = self.TMIN + (pos.x() - r.left()) / r.width() * (self.TMAX - self.TMIN)
        rpm = (r.bottom() - pos.y()) / r.height() * lc.MAX_RPM
        return t, rpm

    def set_points(self, pts):
        self.points = [list(p) for p in pts]
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        pal = self.palette()
        r = self.area()
        txt = QColor(pal.color(QPalette.WindowText))
        grid = QColor(txt)
        grid.setAlpha(35)
        lab = QColor(txt)
        lab.setAlpha(150)
        for t in range(self.TMIN, self.TMAX + 1, 5):
            a = self.to_px(t, 0)
            p.setPen(QPen(grid, 1))
            p.drawLine(QPointF(a.x(), r.top()), QPointF(a.x(), r.bottom()))
            if t % 10 == 0:
                p.setPen(lab)
                p.drawText(QRectF(a.x() - 20, r.bottom() + 4, 40, 16), Qt.AlignCenter, "%d°" % t)
        for rpm in range(0, lc.MAX_RPM + 1, 500):
            a = self.to_px(self.TMIN, rpm)
            p.setPen(QPen(grid, 1))
            p.drawLine(QPointF(r.left(), a.y()), QPointF(r.right(), a.y()))
            if rpm % 1000 == 0:
                p.setPen(lab)
                p.drawText(QRectF(0, a.y() - 8, r.left() - 6, 16), Qt.AlignRight | Qt.AlignVCenter, "%d" % rpm)
        p.setPen(lab)
        p.drawText(QRectF(r.left(), r.bottom() + 16, r.width(), 16), Qt.AlignCenter, "CPU temperature")
        if self.live_temp is not None:
            a = self.to_px(min(max(self.live_temp, self.TMIN), self.TMAX), 0)
            p.setPen(QPen(temp_color(self.live_temp), 1.5, Qt.DashLine))
            p.drawLine(QPointF(a.x(), r.top()), QPointF(a.x(), r.bottom()))
        if self.ref:
            self.draw_steps(p, self.ref, QColor(txt.red(), txt.green(), txt.blue(), 70), 1.5, Qt.DotLine, False)
        self.draw_steps(p, self.points, ACCENT, 2.5, Qt.SolidLine, True)

    def draw_steps(self, p, pts, color, width, style, handles):
        path = QPainterPath()
        prev_t = self.TMIN
        for i, (t, _g, r1, r2) in enumerate(pts):
            rpm = max(r1, r2)
            a = self.to_px(prev_t, rpm)
            b = self.to_px(min(t, self.TMAX), rpm)
            if i == 0:
                path.moveTo(a)
            else:
                path.lineTo(a)
            path.lineTo(b)
            prev_t = min(t, self.TMAX)
        path.lineTo(self.to_px(self.TMAX, max(pts[-1][2], pts[-1][3])))
        p.setPen(QPen(color, width, style))
        p.setBrush(Qt.NoBrush)
        p.drawPath(path)
        if not handles:
            return
        prev_t = self.TMIN
        for i, (t, _g, r1, r2) in enumerate(pts):
            c = self.to_px(min(t, self.TMAX), max(r1, r2))
            active = i == self.live_point
            p.setPen(QPen(QColor("white"), 2))
            p.setBrush(QColor("#f1c40f") if active else ACCENT)
            p.drawEllipse(c, 7 if active else 5.5, 7 if active else 5.5)
            prev_t = t

    def hit(self, pos):
        best, bd = None, 14
        for i, (t, _g, r1, r2) in enumerate(self.points):
            c = self.to_px(min(t, self.TMAX), max(r1, r2))
            d = ((c.x() - pos.x()) ** 2 + (c.y() - pos.y()) ** 2) ** 0.5
            if d < bd:
                best, bd = i, d
        return best

    def mousePressEvent(self, e):
        self.drag = self.hit(e.position())

    def mouseMoveEvent(self, e):
        if self.drag is None:
            self.setCursor(Qt.PointingHandCursor if self.hit(e.position()) is not None else Qt.ArrowCursor)
            return
        i = self.drag
        t, rpm = self.from_px(e.position())
        lo_t = self.points[i - 1][0] if i > 0 else 0
        hi_t = self.points[i + 1][0] if i < len(self.points) - 1 else 127
        t = int(round(min(max(t, lo_t), hi_t)))
        self.points[i][0] = t
        if i > 0:
            lo_r = max(self.points[i - 1][2], self.points[i - 1][3])
            hi_r = max(self.points[i + 1][2], self.points[i + 1][3]) if i < len(self.points) - 1 else lc.MAX_RPM
            rpm = int(round(min(max(rpm, lo_r), hi_r) / 100.0)) * 100
            self.points[i][2] = rpm
            self.points[i][3] = rpm
        self.update()
        self.changed.emit()

    def mouseReleaseEvent(self, _):
        self.drag = None


class Segmented(QWidget):
    clicked = Signal(str)

    def __init__(self):
        super().__init__()
        self.lay = QHBoxLayout(self)
        self.lay.setContentsMargins(0, 0, 0, 0)
        self.lay.setSpacing(6)
        self.group = QButtonGroup(self)
        self.group.setExclusive(True)
        self.buttons = {}

    def set_items(self, items):
        for b in self.buttons.values():
            self.group.removeButton(b)
            b.deleteLater()
        self.buttons = {}
        for key, label in items:
            b = QPushButton(label)
            b.setCheckable(True)
            b.setObjectName("seg")
            b.setMinimumHeight(38)
            b.clicked.connect(lambda _=False, k=key: self.clicked.emit(k))
            self.group.addButton(b)
            self.lay.addWidget(b)
            self.buttons[key] = b

    def select(self, key):
        b = self.buttons.get(key)
        if b and not b.isChecked():
            b.setChecked(True)


class Switch(QAbstractButton):
    def __init__(self):
        super().__init__()
        self.setCheckable(True)
        self.setCursor(Qt.PointingHandCursor)
        self.setFixedSize(46, 26)

    def sizeHint(self):
        return QSize(46, 26)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        on = self.isChecked()
        track = ACCENT if on else QColor(self.palette().color(QPalette.WindowText))
        if not on:
            track.setAlpha(70)
        if not self.isEnabled():
            track.setAlpha(40)
        p.setPen(Qt.NoPen)
        p.setBrush(track)
        p.drawRoundedRect(QRectF(0, 3, 46, 20), 10, 10)
        p.setBrush(QColor("white"))
        x = 24 if on else 2
        p.drawEllipse(QRectF(x, 1, 24, 24).adjusted(2, 2, -2, -2))


def section(title):
    l = QLabel(title)
    l.setObjectName("section")
    return l


def page(title, subtitle=""):
    outer = QScrollArea()
    outer.setWidgetResizable(True)
    outer.setFrameShape(QFrame.NoFrame)
    w = QWidget()
    lay = QVBoxLayout(w)
    lay.setContentsMargins(28, 22, 28, 22)
    lay.setSpacing(14)
    h = QLabel(title)
    h.setObjectName("pageTitle")
    lay.addWidget(h)
    if subtitle:
        s = QLabel(subtitle)
        s.setObjectName("pageSub")
        s.setWordWrap(True)
        lay.addWidget(s)
    outer.setWidget(w)
    return outer, lay


class Dashboard:
    def __init__(self, win):
        self.win = win
        self.widget, lay = page("Dashboard", "Live sensors from the embedded controller, CPU package and battery.")
        self.profile = Segmented()
        self.profile.clicked.connect(win.set_profile)
        lay.addWidget(section("Power mode"))
        lay.addWidget(self.profile)
        grid = QGridLayout()
        grid.setSpacing(12)
        self.cards = {
            "cpu": Card("CPU"),
            "gpu": Card("GPU"),
            "fans": Card("Fans", SERIES["fan1"]),
            "pkg": Card("CPU package power", SERIES["pkg"]),
            "clock": Card("CPU clock"),
            "bat": Card("Battery", SERIES["bat"]),
        }
        for i, k in enumerate(["cpu", "gpu", "fans", "pkg", "clock", "bat"]):
            grid.addWidget(self.cards[k], i // 3, i % 3)
        lay.addLayout(grid)
        self.temps = Chart("Temperatures", [("cpu", "CPU"), ("gpu", "GPU")], 30, 100, "°C")
        self.fans = Chart("Fan speed", [("fan1", "Fan 1"), ("fan2", "Fan 2")], 0, lc.MAX_RPM, "rpm")
        self.power = Chart("Power", [("pkg", "CPU package"), ("bat", "Battery")], 0, 60, "W")
        for c in (self.temps, self.fans, self.power):
            fr = QFrame()
            fr.setObjectName("card")
            fl = QVBoxLayout(fr)
            fl.setContentsMargins(4, 6, 4, 4)
            fl.addWidget(c)
            lay.addWidget(fr)
        lay.addStretch(1)

    def refresh_profiles(self):
        self.profile.set_items([(c, lc.PROFILE_LABELS.get(c, c.title())) for c in lc.profile_choices()])

    def update(self, s):
        self.profile.select(s["profile"])
        self.cards["cpu"].set(fmt(s["cpu"], "°C"), "Package temperature", temp_color(s["cpu"]))
        self.cards["gpu"].set(fmt(s["gpu"], "°C"), "Embedded controller sensor", temp_color(s["gpu"]))
        f1, f2 = s["fan1"], s["fan2"]
        self.cards["fans"].set("%s / %s" % (f1 if f1 is not None else "—", f2 if f2 is not None else "—"),
                               "RPM")
        st = lc.load_json(lc.THERMAL_STATUS, {})
        if st.get("active") and st.get("pl1") is not None:
            s = dict(s, pl1=st["pl1"])
        self.cards["pkg"].set(fmt(s["pkg"], "W", 1),
                              "PL1 %s · PL2 %s" % (fmt(s["pl1"], "W"), fmt(s["pl2"], "W")))
        fr = s["freqs"]
        if fr:
            self.cards["clock"].set("%.2f GHz" % (max(fr) / 1000), "Average %.2f GHz" % (sum(fr) / len(fr) / 1000))
        b = s["bat"]
        if b:
            state = "on AC" if s["ac"] else "on battery"
            self.cards["bat"].set("%d%%" % (b["capacity"] or 0), "%s · %s · %.1f W" % (b["status"], state, b["watts"]))
        self.temps.push("cpu", s["cpu"])
        self.temps.push("gpu", s["gpu"])
        self.fans.push("fan1", f1)
        self.fans.push("fan2", f2)
        self.power.push("pkg", s["pkg"])
        self.power.push("bat", b["watts"] if b else None)
        for c in (self.temps, self.fans, self.power):
            if self.widget.isVisible():
                c.update()


