        self.spins = []
        for i in range(lc.CURVE_POINTS):
            g.addWidget(QLabel(str(i + 1)), i + 1, 0)
            row = []
            for c, (lo, hi, suf, step) in enumerate([(0, 127, " °C", 1), (0, 127, " °C", 1),
                                                    (0, lc.MAX_RPM, " rpm", 100), (0, lc.MAX_RPM, " rpm", 100)]):
                sp = QSpinBox()
