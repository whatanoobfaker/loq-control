# Ethereal palette: near-black ink, glassy surfaces, pastel light.
INK = QColor("#0b0d14")
TEXT = QColor("#e8eaf2")
MUTED = QColor("#7c8299")
ACCENT = QColor("#9aa8ff")
SERIES = {
    "cpu": QColor("#f5a9c4"),
    "gpu": QColor("#9fe6c8"),
    "fan1": QColor("#9cc8ff"),
    "fan2": QColor("#c9b3ff"),
}

PRESET_T = [45, 55, 62, 68, 74, 80, 85, 90, 95, 100]
PRESET_G = [45, 52, 58, 64, 70, 75, 79, 83, 87, 90]
PRESETS = {
    "Quiet": [0, 1600, 2000, 2400, 2800, 3200, 3600, 4000, 4300, 4500],
    "Cool": [0, 2400, 2900, 3400, 3900, 4400, 4900, 5300, 5600, 5800],
    "Maximum": [0, 5800, 5800, 5800, 5800, 5800, 5800, 5800, 5800, 5800],
}

AUTO = "auto"


def preset_points(name):
    return [[PRESET_T[i], PRESET_G[i], r, r] for i, r in enumerate(PRESETS[name])]


def modes():
    """The modes the app offers: Auto, then every firmware mode but Custom."""
    return [(AUTO, "Auto")] + [(c, lc.PROFILE_LABELS.get(c, c.title()))
                               for c in lc.profile_choices() if c != "custom"]


def retry(fn, *a):
    last = None
    for _ in range(4):
        try:
            return fn(*a)
        except OSError as e:
            last = e
            time.sleep(0.25)
    raise last


def temp_color(t):
    if t is None:
        return MUTED
    if t < 65:
        return SERIES["gpu"]
    if t < 82:
        return QColor("#ffd9a0")
    return SERIES["cpu"]


def fmt(v, unit, digits=0):
    if v is None:
        return "—"
    return ("%." + str(digits) + "f%s") % (v, unit)


def faded(c, alpha):
    c = QColor(c)
    c.setAlpha(alpha)
    return c


