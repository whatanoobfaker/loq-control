def retry(fn, *a):
    last = None
    for _ in range(4):
        try:
            return fn(*a)
        except OSError as e:
            last = e
            time.sleep(0.25)
    raise last


def temp_color(t):
    if t is None:
        return QColor("#7f8c8d")
    if t < 65:
        return QColor("#27ae60")
    if t < 80:
        return QColor("#f39c12")
    if t < 90:
        return QColor("#e67e22")
    return QColor("#e74c3c")


def fmt(v, unit, digits=0):
    if v is None:
        return "—"
    return ("%." + str(digits) + "f %s") % (v, unit)


class Card(QFrame):
    def __init__(self, title, color=None):
        super().__init__()
        self.setObjectName("card")
