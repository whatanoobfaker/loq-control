def dark_palette():
    p = QPalette()
    for role, c in ((QPalette.Window, INK), (QPalette.Base, QColor("#121420")), (QPalette.AlternateBase, INK),
                    (QPalette.Text, TEXT), (QPalette.WindowText, TEXT), (QPalette.ButtonText, TEXT),
                    (QPalette.Button, QColor("#141624")), (QPalette.Highlight, ACCENT),
                    (QPalette.HighlightedText, INK), (QPalette.ToolTipBase, QColor("#141624")),
                    (QPalette.ToolTipText, TEXT), (QPalette.PlaceholderText, MUTED)):
        p.setColor(role, c)
    return p


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("LOQ Control")
    app.setDesktopFileName("loq-control")
    app.setQuitOnLastWindowClosed(False)
    app.setStyle("Fusion")
    app.setPalette(dark_palette())
    app.setStyleSheet(STYLE)
    w = Window()
    if "--tray" in sys.argv and w.tray:
        w.hide()
    else:
        w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
