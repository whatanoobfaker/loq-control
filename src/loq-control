        self.load()

    def refresh_profiles(self):
        self.profile.set_items([(c, lc.PROFILE_LABELS.get(c, c.title())) for c in lc.profile_choices()])
        self.restore.blockSignals(True)
        self.restore.setChecked(bool(self.win.cfg.get("restore_profile")))
        self.restore.blockSignals(False)

    def load_thermal(self, source):
        self.th_src = source
        t = lc.thermal_settings(self.win.cfg, source)
        for w in (self.th_switch, self.th_target_sp, self.th_min_sp, self.th_target, self.th_min):
            w.blockSignals(True)
        self.th_switch.setChecked(bool(t["enabled"]))
        self.th_target_sp.setValue(int(t["target"]))
        self.th_target.setValue(int(t["target"]))
        self.th_min_sp.setValue(int(t["min_watts"]))
        self.th_min.setValue(int(t["min_watts"]))
        for w in (self.th_switch, self.th_target_sp, self.th_min_sp, self.th_target, self.th_min):
            w.blockSignals(False)

    def set_thermal_mode(self, mode):
        self.win.cfg.setdefault("thermal", {})["mode"] = mode
        self.save_thermal()

    def save_thermal(self, *_):
        th = {k: lc.thermal_settings(self.win.cfg, k) for k in ("ac", "battery")}
        th["mode"] = lc.thermal_mode(self.win.cfg)
        th[self.th_src] = {"enabled": self.th_switch.isChecked(), "target": self.th_target_sp.value(),
                           "min_watts": self.th_min_sp.value()}
        self.win.cfg["thermal"] = th
        self.win.save()

    def on_restore(self, on):
        self.win.cfg["restore_profile"] = on
        self.win.cfg["profile"] = lc.get_profile()
        self.win.save()

    def load(self):
        saved = self.win.cfg.get("limits", {})
        for name, (sp, _info) in self.rows.items():
            cur = lc.limit_info(name) or {}
            v = saved.get(name)
            for cand in (v, cur.get("value"), cur.get("default"), cur.get("min"), sp.minimum()):
                if cand is not None:
                    sp.setValue(int(cand))
                    break

    def defaults(self):
        for name, (sp, info) in self.rows.items():
            if info["default"] is not None:
                sp.setValue(info["default"])

    def apply(self):
        values = {n: sp.value() for n, (sp, _i) in self.rows.items()}
        self.win.cfg["limits"] = values
        self.win.save()
        if lc.get_profile() != "custom":
            r = QMessageBox.question(self.widget, "Switch to Custom mode",
                                     "These limits only take effect in Custom mode. Switch to Custom now?")
            if r != QMessageBox.Yes:
                self.win.status("Limits saved; they apply the next time you enter Custom mode")
                return
            self.win.set_profile("custom")
        errors = []
        for n, v in values.items():
            try:
                retry(lc.set_limit, n, v)
            except OSError as e:
                errors.append("%s: %s" % (n, e.strerror or e))
        if errors:
            QMessageBox.warning(self.widget, "Some limits were rejected", "\n".join(errors))
        else:
            self.win.status("Custom limits applied")

    def update(self, s):
        self.profile.select(s["profile"])
        custom = s["profile"] == "custom"
        st = lc.load_json(lc.THERMAL_STATUS, {})
        now = lc.power_source()
        names = {"ac": "plugged in", "battery": "on battery"}
        mode = lc.thermal_mode(self.win.cfg)
        for w in (self.th_switch, self.th_target, self.th_target_sp, self.th_min, self.th_min_sp,
                  self.th_lab1, self.th_lab2, self.th_source):
            w.setVisible(mode == "target")
        pl = lc.rapl_limits("/sys/class/powercap/intel-rapl-mmio:0")
        lim = "PL1 %.0f W · PL2 %.0f W" % (pl[0] / 1e6, pl[1] / 1e6) if pl[0] and pl[1] else ""
        skins = "  ".join("%s %.0f°" % (n, t) for n, t in lc.skin_sensors())
        if mode == "dtt":
            running = subprocess.run(["systemctl", "is-active", "--quiet", "thermald.service"]).returncode == 0
            self.th_state.setText("Lenovo DTT via thermald: %s · %s\nSkin sensors: %s" % (
                "running, following the BIOS tables for this mode" if running else "not running", lim, skins))
        elif mode == "off":
            self.th_state.setText("Off: the firmware alone decides (up to 95 W in Balanced). %s" % lim)
        elif st.get("active") and st.get("pl1") is not None:
            self.th_state.setText("Now %s · active: CPU power limit %.0f W of the firmware's %.0f W · CPU %.0f °C" % (
                names[now], st["pl1"], st.get("ceiling") or 0, st.get("temp") or 0))
        elif lc.thermal_settings(self.win.cfg, now)["enabled"]:
            self.th_state.setText("Now %s · starting…" % names[now])
        else:
            self.th_state.setText("Now %s · off for this power source: the firmware alone decides." % names[now])
        warn = ("Warning: on the LOQ 15IRX9 (BIOS NECN), Custom mode is reported to make the embedded controller "
                "assert BD PROCHOT under load and drop the CPU to 400 MHz. Prefer the smart thermal control above.")
        self.note.setText(("Active now. " if custom else
                           "Not active: the firmware only accepts these in Custom mode. ") + warn)


