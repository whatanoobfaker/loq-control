                sp.setSuffix(suf)
                sp.valueChanged.connect(self.from_table)
                g.addWidget(sp, i + 1, c + 1)
                row.append(sp)
            self.spins.append(row)
        self.link = QCheckBox("Keep both fans at the same speed")
        self.link.setChecked(True)
        g.addWidget(self.link, lc.CURVE_POINTS + 1, 0, 1, 5)
