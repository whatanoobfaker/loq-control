    def build_tray(self):
        self.tray = QSystemTrayIcon(self)
        self.tray_menu = QMenu()
        self.tray_menu.addAction("Open LOQ Control", self.show_window)
        self.tray_menu.addSeparator()
        self.tray_profiles = QActionGroup(self)
        self.tray_profiles.setExclusive(True)
        self.tray_profile_actions = {}
        self.tray_sep = self.tray_menu.addSeparator()
        self.max_fans = QAction("Maximum fans", self)
        self.max_fans.setCheckable(True)
        self.max_fans.toggled.connect(self.toggle_max_fans)
        self.tray_menu.addAction(self.max_fans)
        self.tray_menu.addSeparator()
        self.tray_menu.addAction("Quit", self.quit)
        self.tray.setContextMenu(self.tray_menu)
        self.tray.activated.connect(lambda r: r == QSystemTrayIcon.Trigger and self.toggle_window())
        self.tray.show()

    def refresh_tray_profiles(self):
        if not self.tray:
            return
        for a in self.tray_profile_actions.values():
            self.tray_menu.removeAction(a)
            self.tray_profiles.removeAction(a)
        self.tray_profile_actions = {}
        for c in lc.profile_choices():
            a = QAction(lc.PROFILE_LABELS.get(c, c.title()), self)
            a.setCheckable(True)
            a.triggered.connect(lambda _=False, k=c: self.set_profile(k))
            self.tray_profiles.addAction(a)
            self.tray_menu.insertAction(self.tray_sep, a)
            self.tray_profile_actions[c] = a

    def refresh_profiles(self):
        self.dash.refresh_profiles()
        self.power.refresh_profiles()
        self.fans.refresh_profiles()
        self.refresh_tray_profiles()

    def toggle_max_fans(self, on):
        prof = lc.get_profile()
        try:
            if on:
                rpm = PRESETS["Maximum"]
                retry(lc.write_curve, [[PRESET_T[i], PRESET_G[i], rpm[i], rpm[i]] for i in range(lc.CURVE_POINTS)])
                self.status("Fans at maximum until you turn this off or change mode")
            else:
                entry = self.cfg.get("curves", {}).get(prof)
                target = entry["points"] if entry and entry.get("enabled") else self.fans.firmware_curve(prof)
                if target:
                    retry(lc.write_curve, target)
                self.status("Fans back to the %s curve" % lc.PROFILE_LABELS.get(prof, prof))
        except OSError as e:
            self.status("Fan curve write failed: %s" % e)

    def tray_icon(self, t):
        pm = QPixmap(64, 64)
        pm.fill(Qt.transparent)
        p = QPainter(pm)
        p.setRenderHint(QPainter.Antialiasing)
        p.setBrush(temp_color(t))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(2, 2, 60, 60), 14, 14)
        p.setPen(QColor("white"))
        f = QFont()
        f.setBold(True)
        f.setPixelSize(34)
        p.setFont(f)
        p.drawText(pm.rect(), Qt.AlignCenter, "%d" % t if t is not None else "?")
        p.end()
        return QIcon(pm)

    def show_window(self):
        self.showNormal()
        self.raise_()
        self.activateWindow()

    def toggle_window(self):
        if self.isVisible() and not self.isMinimized():
            self.hide()
        else:
            self.show_window()

    def closeEvent(self, e):
        if self.tray and self.ui.get("close_to_tray", True) and not self.quitting:
            e.ignore()
            self.hide()
        else:
            e.accept()
            QApplication.quit()

    def quit(self):
        self.quitting = True
        QApplication.quit()

    def set_ui(self, k, v):
        self.ui[k] = v
        try:
            lc.save_json(self.ui_path, self.ui)
        except OSError:
            pass

    def save(self):
        try:
            lc.save_config(self.cfg)
        except OSError as e:
            self.status("Could not save settings: %s" % e)

    def status(self, msg):
        self.statusBar().showMessage(msg, 6000)
        if self.tray and not self.isVisible():
            self.tray.showMessage("LOQ Control", msg, QSystemTrayIcon.Information, 3000)

    def set_profile(self, name):
        if name == lc.get_profile():
            return
        try:
            retry(lc.set_profile, name)
        except OSError as e:
            QMessageBox.warning(self, "Could not change power mode", str(e))
            return
        if self.max_fans.isChecked() if self.tray else False:
            self.max_fans.blockSignals(True)
            self.max_fans.setChecked(False)
            self.max_fans.blockSignals(False)
        self.cfg["profile"] = name
        self.save()
        self.status("Power mode: %s" % lc.PROFILE_LABELS.get(name, name))
        self.tick()

    def tick(self):
        now = time.monotonic()
        e = lc.rapl_energy()
        pkg = None
        if e is not None and self.last_energy is not None:
            d = e - self.last_energy
            if d < 0:
                d += self.max_energy
            pkg = d / 1e6 / (now - self.last_time)
        self.last_energy, self.last_time = e, now
        f1, f2 = lc.fan_rpms()
        prof = lc.get_profile()
        pl1 = lc.read_int(os.path.join(lc.FWA, "ppt_pl1_spl", "current_value")) if prof == "custom" else None
        pl2 = lc.read_int(os.path.join(lc.FWA, "ppt_pl2_sppt", "current_value")) if prof == "custom" else None
        if pl1 is None:
            v = lc.read_int("/sys/class/powercap/intel-rapl-mmio:0/constraint_0_power_limit_uw")
            pl1 = v / 1e6 if v else None
            v = lc.read_int("/sys/class/powercap/intel-rapl-mmio:0/constraint_1_power_limit_uw")
            pl2 = v / 1e6 if v else None
        s = {
            "profile": prof,
            "cpu": lc.cpu_temp(),
            "gpu": lc.gpu_temp(),
            "fan1": f1,
            "fan2": f2,
            "pkg": pkg,
            "pl1": pl1,
            "pl2": pl2,
            "freqs": lc.cpu_freqs(),
            "bat": lc.battery(),
            "ac": lc.ac_online(),
        }
        if prof != self.known_profile:
            if self.known_profile is not None:
                i = self.fans.combo.findData(prof)
                if i >= 0:
                    self.fans.combo.setCurrentIndex(i)
                QTimer.singleShot(1500, self.fans.load)
            self.known_profile = prof
        for _n, _i, pg in self.pages:
            pg.update(s)
        label = lc.PROFILE_LABELS.get(prof, prof or "?")
        self.side_temp.setText("%s\nCPU %s  ·  GPU %s" % (label, fmt(s["cpu"], "°C"), fmt(s["gpu"], "°C")))
        if self.tray:
            self.tray.setIcon(self.tray_icon(s["cpu"]))
            self.tray.setToolTip("LOQ Control — %s\nCPU %s · GPU %s\nFans %s / %s rpm\nPackage %s" % (
                label, fmt(s["cpu"], "°C"), fmt(s["gpu"], "°C"), f1, f2, fmt(pkg, "W", 1)))
            for k, a in self.tray_profile_actions.items():
                a.setChecked(k == prof)


