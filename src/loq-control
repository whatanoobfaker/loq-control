class Chart(QWidget):
    def __init__(self, title, series, lo, hi, unit):
        super().__init__()
        self.title, self.series, self.lo, self.hi, self.unit = title, series, lo, hi, unit
        self.data = {k: deque(maxlen=HISTORY) for k, _ in series}
        self.setMinimumHeight(150)

    def push(self, key, v):
        self.data[key].append(v)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = self.rect().adjusted(40, 34, -16, -14)
        p.setPen(MUTED)
        p.drawText(16, 22, self.title.upper())
        x = self.width() - 16
        for key, label in reversed(self.series):
            vals = [v for v in self.data[key] if v is not None]
            txt = "%s  %s" % (label, fmt(vals[-1], self.unit) if vals else "—")
            x -= p.fontMetrics().horizontalAdvance(txt)
            p.setPen(SERIES[key])
            p.drawText(x, 22, txt)
            x -= 22
        hi = self.hi
        for key, _ in self.series:
            vals = [v for v in self.data[key] if v is not None]
            if vals:
                hi = max(hi, max(vals))
        lo = self.lo
        for i in range(3):
            y = r.bottom() - i * r.height() / 2
            p.setPen(QPen(faded(TEXT, 14), 1))
            p.drawLine(QPointF(r.left(), y), QPointF(r.right(), y))
            p.setPen(faded(MUTED, 160))
            p.drawText(QRectF(0, y - 8, r.left() - 8, 16), Qt.AlignRight | Qt.AlignVCenter,
                       "%d" % (lo + (hi - lo) * i / 2))
        for key, _ in self.series:
            pts = list(self.data[key])
            if len(pts) < 2:
                continue
            path, fill = QPainterPath(), QPainterPath()
            started, last_x = False, None
            off = HISTORY - len(pts)
            for i, v in enumerate(pts):
                if v is None:
                    continue
                px = r.left() + (off + i) * r.width() / (HISTORY - 1)
                py = r.bottom() - (min(max(v, lo), hi) - lo) / (hi - lo) * r.height()
                if not started:
                    path.moveTo(px, py)
                    fill.moveTo(px, r.bottom())
                    fill.lineTo(px, py)
                    started = True
                else:
                    path.lineTo(px, py)
                    fill.lineTo(px, py)
                last_x = px
            if not started:
                continue
            fill.lineTo(last_x, r.bottom())
            fill.closeSubpath()
            g = QLinearGradient(0, r.top(), 0, r.bottom())
            g.setColorAt(0, faded(SERIES[key], 46))
            g.setColorAt(1, faded(SERIES[key], 0))
            p.fillPath(fill, QBrush(g))
            p.setPen(QPen(faded(SERIES[key], 60), 5))
            p.drawPath(path)
            p.setPen(QPen(SERIES[key], 1.6))
            p.drawPath(path)


class CurveEditor(QWidget):
    changed = Signal()

    TMIN, TMAX = 30, 105

    def __init__(self):
        super().__init__()
        self.points = [[0, 0, 0, 0] for _ in range(lc.CURVE_POINTS)]
        self.ref = None
        self.live_temp = None
        self.drag = None
        self.setMinimumHeight(320)
        self.setMouseTracking(True)

    def area(self):
        return self.rect().adjusted(56, 18, -20, -36)

    def to_px(self, t, rpm):
        r = self.area()
        x = r.left() + (t - self.TMIN) / (self.TMAX - self.TMIN) * r.width()
        y = r.bottom() - rpm / lc.MAX_RPM * r.height()
        return QPointF(x, y)

    def from_px(self, pos):
        r = self.area()
        t = self.TMIN + (pos.x() - r.left()) / r.width() * (self.TMAX - self.TMIN)
        rpm = (r.bottom() - pos.y()) / r.height() * lc.MAX_RPM
        return t, rpm

    def set_points(self, pts):
        self.points = [list(p) for p in pts]
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = self.area()
        for t in range(self.TMIN, self.TMAX + 1, 10):
            a = self.to_px(t, 0)
            p.setPen(QPen(faded(TEXT, 12), 1))
            p.drawLine(QPointF(a.x(), r.top()), QPointF(a.x(), r.bottom()))
            p.setPen(faded(MUTED, 170))
            p.drawText(QRectF(a.x() - 20, r.bottom() + 6, 40, 16), Qt.AlignCenter, "%d°" % t)
        for rpm in range(0, lc.MAX_RPM + 1, 1000):
            a = self.to_px(self.TMIN, rpm)
            p.setPen(QPen(faded(TEXT, 12), 1))
            p.drawLine(QPointF(r.left(), a.y()), QPointF(r.right(), a.y()))
            p.setPen(faded(MUTED, 170))
            p.drawText(QRectF(0, a.y() - 8, r.left() - 8, 16), Qt.AlignRight | Qt.AlignVCenter, "%d" % rpm)
        if self.live_temp is not None:
            a = self.to_px(min(max(self.live_temp, self.TMIN), self.TMAX), 0)
            p.setPen(QPen(faded(temp_color(self.live_temp), 150), 1, Qt.DashLine))
            p.drawLine(QPointF(a.x(), r.top()), QPointF(a.x(), r.bottom()))
        if self.ref:
            self.draw_steps(p, self.ref, faded(TEXT, 50), 1.2, Qt.DotLine, False)
        self.draw_steps(p, self.points, ACCENT, 2, Qt.SolidLine, True)

    def draw_steps(self, p, pts, color, width, style, handles):
        path = QPainterPath()
        prev_t = self.TMIN
        for i, (t, _g, r1, r2) in enumerate(pts):
            rpm = max(r1, r2)
            a = self.to_px(prev_t, rpm)
            b = self.to_px(min(t, self.TMAX), rpm)
            if i == 0:
                path.moveTo(a)
            else:
                path.lineTo(a)
            path.lineTo(b)
            prev_t = min(t, self.TMAX)
        path.lineTo(self.to_px(self.TMAX, max(pts[-1][2], pts[-1][3])))
        p.setBrush(Qt.NoBrush)
        if handles:
            p.setPen(QPen(faded(color, 55), width + 5))
            p.drawPath(path)
        p.setPen(QPen(color, width, style))
        p.drawPath(path)
        if not handles:
            return
        for t, _g, r1, r2 in pts:
            c = self.to_px(min(t, self.TMAX), max(r1, r2))
            p.setPen(Qt.NoPen)
            p.setBrush(faded(color, 60))
            p.drawEllipse(c, 9, 9)
            p.setBrush(INK)
            p.setPen(QPen(color, 1.6))
            p.drawEllipse(c, 4.5, 4.5)

    def hit(self, pos):
        best, bd = None, 14
        for i, (t, _g, r1, r2) in enumerate(self.points):
            c = self.to_px(min(t, self.TMAX), max(r1, r2))
            d = ((c.x() - pos.x()) ** 2 + (c.y() - pos.y()) ** 2) ** 0.5
            if d < bd:
                best, bd = i, d
        return best

    def mousePressEvent(self, e):
        self.drag = self.hit(e.position())

    def mouseMoveEvent(self, e):
        if self.drag is None:
            self.setCursor(Qt.PointingHandCursor if self.hit(e.position()) is not None else Qt.ArrowCursor)
            return
        i = self.drag
        t, rpm = self.from_px(e.position())
        lo_t = self.points[i - 1][0] if i > 0 else 0
        hi_t = self.points[i + 1][0] if i < len(self.points) - 1 else 127
        self.points[i][0] = int(round(min(max(t, lo_t), hi_t)))
        if i > 0:
            lo_r = max(self.points[i - 1][2], self.points[i - 1][3])
            hi_r = max(self.points[i + 1][2], self.points[i + 1][3]) if i < len(self.points) - 1 else lc.MAX_RPM
            rpm = int(round(min(max(rpm, lo_r), hi_r) / 100.0)) * 100
            self.points[i][2] = rpm
            self.points[i][3] = rpm
        self.update()
        self.changed.emit()

    def mouseReleaseEvent(self, _):
        self.drag = None


class Segmented(QFrame):
    clicked = Signal(str)

    def __init__(self):
        super().__init__()
        self.setObjectName("segbar")
        self.lay = QHBoxLayout(self)
        self.lay.setContentsMargins(4, 4, 4, 4)
        self.lay.setSpacing(4)
        self.group = QButtonGroup(self)
        self.group.setExclusive(True)
        self.buttons = {}

    def set_items(self, items):
        for b in self.buttons.values():
            self.group.removeButton(b)
            b.deleteLater()
        self.buttons = {}
        for key, label in items:
            b = QPushButton(label)
            b.setCheckable(True)
            b.setObjectName("seg")
            b.setCursor(Qt.PointingHandCursor)
            b.setMinimumHeight(36)
            b.clicked.connect(lambda _=False, k=key: self.clicked.emit(k))
            self.group.addButton(b)
            self.lay.addWidget(b)
            self.buttons[key] = b

    def select(self, key):
        b = self.buttons.get(key)
        if b is None:
            self.group.setExclusive(False)
            for x in self.buttons.values():
                x.setChecked(False)
            self.group.setExclusive(True)
        elif not b.isChecked():
            b.setChecked(True)


class Switch(QAbstractButton):
    def __init__(self):
        super().__init__()
        self.setCheckable(True)
        self.setCursor(Qt.PointingHandCursor)
        self.setFixedSize(44, 24)

    def sizeHint(self):
        return QSize(44, 24)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        on = self.isChecked()
        p.setPen(QPen(faded(ACCENT if on else TEXT, 120 if on else 40), 1))
        p.setBrush(faded(ACCENT, 60) if on else faded(TEXT, 10))
        if not self.isEnabled():
            p.setOpacity(0.4)
        p.drawRoundedRect(QRectF(0.5, 2.5, 43, 19), 9.5, 9.5)
        p.setPen(Qt.NoPen)
        p.setBrush(ACCENT if on else faded(TEXT, 150))
        p.drawEllipse(QRectF(24 if on else 4, 5, 14, 14))


def page(title, subtitle=""):
    outer = QScrollArea()
    outer.setWidgetResizable(True)
    outer.setFrameShape(QFrame.NoFrame)
    w = QWidget()
    w.setObjectName("pageBody")
    lay = QVBoxLayout(w)
    lay.setContentsMargins(40, 34, 40, 34)
    lay.setSpacing(18)
    h = QLabel(title)
    h.setObjectName("pageTitle")
    lay.addWidget(h)
    if subtitle:
        s = QLabel(subtitle)
        s.setObjectName("hint")
        s.setWordWrap(True)
        lay.addWidget(s)
    lay.addSpacing(4)
    outer.setWidget(w)
    return outer, lay


def card(widget=None, margins=(20, 16, 20, 16)):
    fr = QFrame()
    fr.setObjectName("card")
    v = QVBoxLayout(fr)
    v.setContentsMargins(*margins)
    if widget is not None:
        v.addWidget(widget)
    return fr, v


class Overview:
    def __init__(self, win):
        self.win = win
        self.widget, lay = page("Overview")
        self.mode = Segmented()
        self.mode.clicked.connect(win.set_mode)
        lay.addWidget(self.mode)
        self.state = QLabel()
        self.state.setObjectName("hint")
        self.state.setWordWrap(True)
        lay.addWidget(self.state)
        grid = QGridLayout()
        grid.setSpacing(14)
        self.tiles = {k: Tile(t) for k, t in (("cpu", "CPU"), ("gpu", "GPU"), ("fans", "Fans"), ("pkg", "CPU power"))}
        for i, k in enumerate(("cpu", "gpu", "fans", "pkg")):
            grid.addWidget(self.tiles[k], 0, i)
        lay.addLayout(grid)
        self.temps = Chart("Temperature", [("cpu", "CPU"), ("gpu", "GPU")], 30, 100, "°")
        self.fans = Chart("Fans", [("fan1", "Left"), ("fan2", "Right")], 0, lc.MAX_RPM, "")
        for c in (self.temps, self.fans):
            lay.addWidget(card(c, (6, 6, 6, 6))[0])
        lay.addStretch(1)

    def refresh_profiles(self):
        self.mode.set_items(modes())

    def update(self, s):
        auto = s["cfg"].get("auto", True)
        self.mode.select(AUTO if auto else s["profile"])
        st = s["status"]
        label = lc.PROFILE_LABELS.get(s["profile"], s["profile"] or "?")
        if auto:
            boost = (st.get("auto") or {}).get("state") == "boost"
            text = ("Auto · boosting in %s — fans unlocked to full speed until things cool down" % label if boost else
                    "Auto · %s — moves to Extreme on its own when the machine stays hot" % label)
        elif s["profile"] == "custom":
            text = "Custom mode, set outside the app"
        else:
            text = "%s, chosen by hand" % label
        if st.get("guest_cpu_limit"):
            text += "\nVM Dynamic Boost holds the CPU at %.0f W for the GPU" % st["guest_cpu_limit"]
        self.state.setText(text)
        self.tiles["cpu"].set(fmt(s["cpu"], "°"), "package", temp_color(s["cpu"]))
        self.tiles["gpu"].set(fmt(s["gpu"], "°"), "embedded controller", temp_color(s["gpu"]))
        f1, f2 = s["fan1"], s["fan2"]
        rpm = max(f1 or 0, f2 or 0)
        self.tiles["fans"].set("%d" % rpm if f1 is not None else "—", "%s · %s rpm" % (f1, f2))
        self.tiles["pkg"].set(fmt(s["pkg"], " W"), "limit %s" % fmt(s["pl1"], " W"))
        self.temps.push("cpu", s["cpu"])
        self.temps.push("gpu", s["gpu"])
        self.fans.push("fan1", f1)
        self.fans.push("fan2", f2)
        if self.widget.isVisible():
            self.temps.update()
            self.fans.update()


class FanPage:
    def __init__(self, win):
        self.win = win
        self.widget, lay = page("Fans", "Each mode keeps its own curve in the embedded controller. Drag the points; "
                                        "the dotted line is the firmware's curve.")
        top = QHBoxLayout()
        top.setSpacing(12)
        self.combo = QComboBox()
        self.combo.currentIndexChanged.connect(self.load)
        top.addWidget(self.combo)
        top.addStretch(1)
        lab = QLabel("Use my curve")
        lab.setObjectName("hint")
        top.addWidget(lab)
        self.enabled = Switch()
        top.addWidget(self.enabled)
        lay.addLayout(top)
        self.editor = CurveEditor()
        lay.addWidget(card(self.editor, (8, 10, 8, 4))[0])
        pre = QHBoxLayout()
        pre.setSpacing(8)
        for name in ["Firmware"] + list(PRESETS):
            b = QPushButton(name)
            b.setObjectName("chip")
            b.setCursor(Qt.PointingHandCursor)
            b.clicked.connect(lambda _=False, n=name: self.preset(n))
            pre.addWidget(b)
        pre.addStretch(1)
        ap = QPushButton("Apply")
        ap.setObjectName("primary")
        ap.setCursor(Qt.PointingHandCursor)
        ap.clicked.connect(self.apply)
        pre.addWidget(ap)
        lay.addLayout(pre)
        lay.addStretch(1)

    def refresh_profiles(self):
        cur = lc.get_profile()
        self.combo.blockSignals(True)
        self.combo.clear()
        for key, label in modes()[1:]:
            self.combo.addItem(label, key)
        self.combo.setCurrentIndex(max(self.combo.findData(cur), 0))
        self.combo.blockSignals(False)
        self.load()

    def profile(self):
        return self.combo.currentData()

    def firmware_curve(self, prof):
        fw = lc.load_firmware_curves().get(prof)
        if fw:
            return fw
        entry = self.win.cfg.get("curves", {}).get(prof, {})
        if prof == lc.get_profile() and not entry.get("enabled"):
            return lc.read_curve()
        return None

    def load(self):
        prof = self.profile()
        if not prof:
            return
        entry = self.win.cfg.get("curves", {}).get(prof)
        fw = self.firmware_curve(prof)
        self.editor.ref = fw
        pts = entry["points"] if entry and entry.get("points") else (fw or lc.read_curve())
        self.enabled.setChecked(bool(entry and entry.get("enabled")))
        if pts:
            self.editor.set_points(pts)

    def preset(self, name):
        if name == "Firmware":
            fw = self.firmware_curve(self.profile())
            if not fw:
                self.win.status("The firmware curve for this mode is captured the first time you use the mode")
                return
            self.editor.set_points(fw)
            self.enabled.setChecked(False)
            return
        self.editor.set_points(preset_points(name))
        self.enabled.setChecked(True)

    def apply(self):
        pts = [list(p) for p in self.editor.points]
        err = lc.validate_curve(pts)
        if err:
            QMessageBox.warning(self.widget, "Invalid curve", err)
            return
        prof, on = self.profile(), self.enabled.isChecked()
        self.win.edit_cfg(lambda c: c.setdefault("curves", {}).__setitem__(prof, {"enabled": on, "points": pts}))
        if prof != lc.get_profile():
            self.win.status("Saved — it applies when %s is active" % self.combo.currentText())
            return
        target = pts if on else self.firmware_curve(prof)
        if not target:
            return
        try:
            retry(lc.write_curve, target)
            self.win.status("Fan curve applied" if on else "Firmware curve restored")
        except OSError as e:
            QMessageBox.warning(self.widget, "Fan curve rejected", str(e))

    def update(self, s):
        self.editor.live_temp = s["cpu"]
        if self.widget.isVisible():
            self.editor.update()


class DevicePage:
    def __init__(self, win):
        self.win = win
        self.widget, lay = page("Device")
        self.switches = {}
        items = [t for t in lc.TOGGLES if os.path.exists(os.path.join(t[1], t[0]))]
        if items:
            box, v = card(margins=(20, 6, 20, 6))
            for i, (name, _base, label, desc, _g) in enumerate(items):
                if i:
                    line = QFrame()
                    line.setObjectName("sep")
                    line.setFixedHeight(1)
                    v.addWidget(line)
                h = QHBoxLayout()
                h.setContentsMargins(0, 10, 0, 10)
                t = QVBoxLayout()
                t.setSpacing(2)
                a = QLabel(label)
                a.setObjectName("rowTitle")
                b = QLabel(desc)
                b.setObjectName("hint")
                t.addWidget(a)
                t.addWidget(b)
                h.addLayout(t, 1)
                sw = Switch()
                sw.toggled.connect(lambda on, n=name: self.toggle(n, on))
                h.addWidget(sw)
                v.addLayout(h)
                self.switches[name] = sw
            lay.addWidget(box)
        self.leds = {}
        led_list = lc.leds()
        if led_list:
            box, v = card()
            g = QGridLayout()
            g.setVerticalSpacing(12)
            v.addLayout(g)
            for row, (name, label, d) in enumerate(led_list):
                mx = lc.read_int(os.path.join(d, "max_brightness"), 1) or 1
                l = QLabel(label)
                l.setObjectName("rowTitle")
                g.addWidget(l, row, 0)
                if mx > 1:
                    sl = QSlider(Qt.Horizontal)
                    sl.setRange(0, mx)
                    sl.setPageStep(1)
                    sl.valueChanged.connect(lambda val, n=name: self.led(n, val))
                    g.addWidget(sl, row, 1)
                    self.leds[name] = sl
                else:
                    sw = Switch()
                    sw.toggled.connect(lambda on, n=name: self.led(n, int(on)))
                    g.addWidget(sw, row, 1, Qt.AlignRight)
                    self.leds[name] = sw
            g.setColumnStretch(1, 1)
            lay.addWidget(box)
        lay.addStretch(1)
        self.load()

    def load(self):
        for name, sw in self.switches.items():
            v = lc.read(lc.toggle_path(name))
            sw.blockSignals(True)
            sw.setChecked(v == "1")
            sw.setEnabled(v is not None)
            sw.blockSignals(False)
        for name, w in self.leds.items():
            v = lc.read_int(os.path.join("/sys/class/leds", name, "brightness"), 0)
            w.blockSignals(True)
            if isinstance(w, QSlider):
                w.setValue(v)
            else:
                w.setChecked(v > 0)
            w.blockSignals(False)

    def toggle(self, name, on):
        try:
            retry(lc.write, lc.toggle_path(name), int(on))
        except OSError as e:
            QMessageBox.warning(self.widget, "Could not change setting", "%s: %s" % (name, e.strerror or e))
            self.load()
            return

        def change(c):
            c.setdefault("toggles", {})[name] = int(on)
            other = lc.EXCLUSIVE.get(name)
            if on and other and other in self.switches:
                c["toggles"][other] = 0
        self.win.edit_cfg(change)
        QTimer.singleShot(300, self.load)

    def led(self, name, value):
        try:
            lc.write(os.path.join("/sys/class/leds", name, "brightness"), value)
        except OSError as e:
            self.win.status("%s: %s" % (name, e.strerror or e))
            return
        self.win.edit_cfg(lambda c: c.setdefault("leds", {}).__setitem__(name, value))

    def update(self, s):
        pass


class SettingsPage:
    AUTOSTART = os.path.expanduser("~/.config/autostart/loq-control.desktop")

    def __init__(self, win):
        self.win = win
        self.widget, lay = page("Settings")
        box, v = card(margins=(20, 6, 20, 6))
        rows = [("Start with the session", "Open in the tray when you log in",
                 os.path.exists(self.AUTOSTART), self.set_autostart),
                ("Keep running in the tray", "Closing the window leaves LOQ Control in the tray",
                 win.ui.get("close_to_tray", True), lambda on: win.set_ui("close_to_tray", on))]
        for i, (title, desc, state, fn) in enumerate(rows):
            if i:
                line = QFrame()
                line.setObjectName("sep")
                line.setFixedHeight(1)
                v.addWidget(line)
            h = QHBoxLayout()
            h.setContentsMargins(0, 10, 0, 10)
            t = QVBoxLayout()
            t.setSpacing(2)
            a = QLabel(title)
            a.setObjectName("rowTitle")
            b = QLabel(desc)
            b.setObjectName("hint")
            t.addWidget(a)
            t.addWidget(b)
            h.addLayout(t, 1)
            sw = Switch()
            sw.setChecked(state)
            sw.toggled.connect(fn)
            h.addWidget(sw)
            v.addLayout(h)
        lay.addWidget(box)
        self.info = QLabel()
        self.info.setObjectName("hint")
        self.info.setWordWrap(True)
        self.info.setTextInteractionFlags(Qt.TextSelectableByMouse)
        lay.addWidget(card(self.info)[0])
        lay.addStretch(1)
        self.refresh()

    def set_autostart(self, on):
        if on:
            os.makedirs(os.path.dirname(self.AUTOSTART), exist_ok=True)
            with open("/usr/share/loq-control/loq-control-autostart.desktop") as f, open(self.AUTOSTART, "w") as o:
                o.write(f.read())
        elif os.path.exists(self.AUTOSTART):
            os.remove(self.AUTOSTART)

    def refresh(self):
        def svc(name):
            try:
                return subprocess.run(["systemctl", "is-active", name], capture_output=True, text=True).stdout.strip()
            except OSError:
                return "unknown"
        product = lc.read("/sys/class/dmi/id/product_version", "")
        bios = lc.read("/sys/class/dmi/id/bios_version", "")
        writable = os.access(os.path.join(lc.LEGION, "fancurve"), os.W_OK)
        self.info.setText("%s · BIOS %s\nService %s · %s\n%s" % (
            product, bios, svc("loqd.service"),
            "controls writable" if writable else "no write access — is loqd running and are you in '%s'?" % lc.GROUP,
            lc.CONFIG))

    def update(self, s):
        pass


class Window(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("LOQ Control")
        self.setWindowIcon(QIcon.fromTheme("computer-laptop"))
        self.resize(1080, 760)
        self.cfg = lc.load_config()
        self.ui_path = os.path.expanduser("~/.config/loq-control.json")
        self.ui = lc.load_json(self.ui_path, {"close_to_tray": True})
        self.last_energy = None
        self.last_time = None
        self.max_energy = lc.rapl_max_energy() or (1 << 32)
        self.quitting = False

        central = QWidget()
        central.setObjectName("root")
        h = QHBoxLayout(central)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(0)
        side = QFrame()
        side.setObjectName("side")
        side.setFixedWidth(196)
        sv = QVBoxLayout(side)
        sv.setContentsMargins(18, 30, 18, 22)
        brand = QLabel("loq")
        brand.setObjectName("brand")
        sv.addWidget(brand)
        sv.addSpacing(26)
        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        sv.addWidget(self.nav, 1)
        self.side_info = QLabel()
        self.side_info.setObjectName("hint")
        self.side_info.setWordWrap(True)
        sv.addWidget(self.side_info)
        h.addWidget(side)
        self.stack = QStackedWidget()
        h.addWidget(self.stack, 1)
        self.setCentralWidget(central)
        self.statusBar().setSizeGripEnabled(False)

        self.overview = Overview(self)
        self.fans = FanPage(self)
        self.device = DevicePage(self)
        self.settings = SettingsPage(self)
        self.pages = [("Overview", self.overview), ("Fans", self.fans), ("Device", self.device),
                      ("Settings", self.settings)]
        for name, pg in self.pages:
            it = QListWidgetItem(name)
            it.setSizeHint(QSize(0, 38))
            self.nav.addItem(it)
            self.stack.addWidget(pg.widget)
        self.nav.currentRowChanged.connect(self.stack.setCurrentIndex)
        self.nav.currentRowChanged.connect(lambda i: self.pages[i][1] is self.settings and self.settings.refresh())
        self.nav.setCurrentRow(0)

        self.tray = None
        if QSystemTrayIcon.isSystemTrayAvailable():
            self.build_tray()
        self.known_profile = None
        self.refresh_profiles()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.tick)
        self.timer.start(1000)
        self.tick()

    def build_tray(self):
        self.tray = QSystemTrayIcon(self)
        self.tray_menu = QMenu()
        self.tray_menu.addAction("Open LOQ Control", self.show_window)
        self.tray_menu.addSeparator()
        self.tray_modes = QActionGroup(self)
        self.tray_modes.setExclusive(True)
        self.tray_mode_actions = {}
        self.tray_sep = self.tray_menu.addSeparator()
        self.tray_menu.addAction("Quit", self.quit)
        self.tray.setContextMenu(self.tray_menu)
        self.tray.activated.connect(lambda r: r == QSystemTrayIcon.Trigger and self.toggle_window())
        self.tray.show()

    def refresh_tray_modes(self):
        if not self.tray:
            return
        for a in self.tray_mode_actions.values():
            self.tray_menu.removeAction(a)
            self.tray_modes.removeAction(a)
        self.tray_mode_actions = {}
        for key, label in modes():
            a = QAction(label, self)
            a.setCheckable(True)
            a.triggered.connect(lambda _=False, k=key: self.set_mode(k))
            self.tray_modes.addAction(a)
            self.tray_menu.insertAction(self.tray_sep, a)
            self.tray_mode_actions[key] = a

    def refresh_profiles(self):
        self.overview.refresh_profiles()
        self.fans.refresh_profiles()
        self.refresh_tray_modes()

    def tray_icon(self, t):
        pm = QPixmap(64, 64)
        pm.fill(Qt.transparent)
        p = QPainter(pm)
        p.setRenderHint(QPainter.Antialiasing)
        c = temp_color(t)
        p.setPen(QPen(c, 5))
        p.setBrush(faded(INK, 230))
        p.drawEllipse(QRectF(4, 4, 56, 56))
        p.setPen(c)
        f = QFont()
        f.setPixelSize(26)
        f.setWeight(QFont.DemiBold)
        p.setFont(f)
        p.drawText(pm.rect(), Qt.AlignCenter, "%d" % t if t is not None else "?")
        p.end()
        return QIcon(pm)

    def show_window(self):
        self.showNormal()
        self.raise_()
        self.activateWindow()

    def toggle_window(self):
        if self.isVisible() and not self.isMinimized():
            self.hide()
        else:
            self.show_window()

    def closeEvent(self, e):
        if self.tray and self.ui.get("close_to_tray", True) and not self.quitting:
            e.ignore()
            self.hide()
        else:
            e.accept()
            QApplication.quit()

    def quit(self):
        self.quitting = True
        QApplication.quit()

    def set_ui(self, k, v):
        self.ui[k] = v
        try:
            lc.save_json(self.ui_path, self.ui)
        except OSError:
            pass

    def edit_cfg(self, fn):
        # loqd edits the config too (Auto steps aside on a manual mode change),
        # so always change the copy on disk, never a stale one.
        cfg = lc.load_config()
        fn(cfg)
        try:
            lc.save_config(cfg)
        except OSError as e:
            self.status("Could not save settings: %s" % e)
        self.cfg = cfg

    def status(self, msg):
        self.statusBar().showMessage(msg, 6000)
        if self.tray and not self.isVisible():
            self.tray.showMessage("LOQ Control", msg, QSystemTrayIcon.Information, 3000)

    def set_mode(self, key):
        if key == AUTO:
            self.edit_cfg(lambda c: c.__setitem__("auto", True))
            self.status("Auto: LOQ Control picks the mode from the load")
        else:
            self.edit_cfg(lambda c: c.__setitem__("auto", False))
            if key != lc.get_profile():
                try:
                    retry(lc.set_profile, key)
                except OSError as e:
                    QMessageBox.warning(self, "Could not change power mode", str(e))
                    return
            self.status("Power mode: %s" % lc.PROFILE_LABELS.get(key, key))
        self.tick()

    def tick(self):
        now = time.monotonic()
        e = lc.rapl_energy()
        pkg = None
        if e is not None and self.last_energy is not None:
            d = e - self.last_energy
            if d < 0:
                d += self.max_energy
            pkg = d / 1e6 / (now - self.last_time)
        self.last_energy, self.last_time = e, now
        f1, f2 = lc.fan_rpms()
        prof = lc.get_profile()
        self.cfg = lc.load_config()
        st = lc.load_json(lc.THERMAL_STATUS, {})
        v = lc.read_int("/sys/class/powercap/intel-rapl-mmio:0/constraint_0_power_limit_uw")
        s = {
            "profile": prof,
            "cfg": self.cfg,
            "status": st,
            "cpu": lc.cpu_temp(),
            "gpu": lc.gpu_temp(),
            "fan1": f1,
            "fan2": f2,
            "pkg": pkg,
            "pl1": v / 1e6 if v else None,
        }
        if prof != self.known_profile:
            if self.known_profile is not None:
                i = self.fans.combo.findData(prof)
                if i >= 0:
                    self.fans.combo.setCurrentIndex(i)
                QTimer.singleShot(1500, self.fans.load)
            self.known_profile = prof
        for _n, pg in self.pages:
            pg.update(s)
        auto = self.cfg.get("auto", True)
        label = lc.PROFILE_LABELS.get(prof, prof or "?")
        b = lc.battery()
        bat = "  ·  %d%%" % b["capacity"] if b and b.get("capacity") is not None else ""
        self.side_info.setText("%s%s\nCPU %s  ·  GPU %s%s" % ("Auto · " if auto else "", label,
                                                            fmt(s["cpu"], "°"), fmt(s["gpu"], "°"), bat))
        if self.tray:
            self.tray.setIcon(self.tray_icon(s["cpu"]))
            self.tray.setToolTip("LOQ Control — %s%s\nCPU %s · GPU %s\nFans %s / %s rpm" % (
                "Auto · " if auto else "", label, fmt(s["cpu"], "°C"), fmt(s["gpu"], "°C"), f1, f2))
            for k, a in self.tray_mode_actions.items():
                a.setChecked(k == (AUTO if auto else prof))


