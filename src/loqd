#!/usr/bin/python3
import grp
import json
import os
import select
import signal
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/loq-control")
import loqcommon as lc
import loqdtt


def log(msg):
    print(msg, flush=True)


def grant():
    gid = grp.getgrnam(lc.GROUP).gr_gid
    for p in lc.controlled_paths():
        try:
            os.chown(p, 0, gid)
            mode = 0o640 if p.endswith("energy_uj") else 0o664
            os.chmod(p, mode)
        except OSError as e:
            log("grant %s: %s" % (p, e))
    os.makedirs(lc.STATE_DIR, exist_ok=True)
    os.chown(lc.STATE_DIR, 0, gid)
    os.chmod(lc.STATE_DIR, 0o2775)
    for p in (lc.CONFIG, lc.FIRMWARE_CURVES):
        if os.path.exists(p):
            os.chown(p, 0, gid)
            os.chmod(p, 0o664)


def needs_grant():
    try:
        st = os.stat(os.path.join(lc.LEGION, "fancurve"))
    except OSError:
        return False
    return not st.st_mode & 0o020


def wait_for_hardware(timeout=30):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        if os.path.exists(os.path.join(lc.LEGION, "fancurve")) and os.path.exists(lc.profile_path()):
            return True
        time.sleep(0.5)
    return False


def capture_firmware_curve(profile):
    if not profile:
        return
    curves = lc.load_firmware_curves()
    if profile in curves:
        return
    pts = lc.read_curve()
    if pts:
        curves[profile] = pts
        lc.save_json(lc.FIRMWARE_CURVES, curves)
        log("captured firmware curve for %s" % profile)


def apply_curve(cfg, profile):
    entry = cfg.get("curves", {}).get(profile)
    if not entry or not entry.get("enabled"):
        return
    pts = entry.get("points")
    err = lc.validate_curve(pts or [])
    if err:
        log("curve for %s invalid: %s" % (profile, err))
        return
    for _ in range(5):
        try:
            lc.write_curve(pts)
            if lc.read_curve() == pts:
                log("applied custom curve for %s" % profile)
                return
        except OSError as e:
            log("curve write: %s" % e)
        time.sleep(0.4)


def apply_toggles(cfg):
    for name, value in cfg.get("toggles", {}).items():
        p = lc.toggle_path(name)
        if p and os.path.exists(p) and lc.read(p) != str(value):
            try:
                lc.write(p, value)
            except OSError as e:
                log("toggle %s: %s" % (name, e))


def apply_leds(cfg):
    for name, value in cfg.get("leds", {}).items():
        p = os.path.join("/sys/class/leds", name, "brightness")
        if os.path.exists(p):
            try:
                lc.write(p, value)
            except OSError as e:
                log("led %s: %s" % (name, e))


class AutoMode:
    """Lenovo Vantage's Auto mode: pick the firmware mode from the load.

    Balanced caps the fans at about 4000 RPM in the EC itself - no fan curve
    gets past that - so when the machine stays hot it moves to Extreme, where
    the EC allows 5800 RPM and the limits rise, and drops back to Balanced
    once it has cooled. Temperatures are the EC's GPU sensor (it still reads
    the GPU while it is passed through to a VM) and the CPU package.
    """
    UP_GPU, UP_CPU, UP_SECONDS = 85, 90, 10
    DOWN_GPU, DOWN_CPU, DOWN_SECONDS = 72, 80, 60

    def __init__(self):
        self.cpu = None
        self.gpu = None
        self.hot_since = None
        self.cool_since = None
        self.expect = None
        self.state = None

    @staticmethod
    def smooth(old, new):
        if new is None:
            return old
        return new if old is None else old * 0.7 + new * 0.3

    def step(self, cfg, current):
        if not cfg.get("auto", True):
            self.state = None
            return
        now = time.monotonic()
        self.cpu = self.smooth(self.cpu, lc.cpu_temp())
        self.gpu = self.smooth(self.gpu, lc.gpu_temp())
        cpu, gpu = self.cpu or 0, self.gpu or 0
        hot = gpu >= self.UP_GPU or cpu >= self.UP_CPU
        cool = gpu < self.DOWN_GPU and cpu < self.DOWN_CPU
        self.hot_since = (self.hot_since or now) if hot else None
        self.cool_since = (self.cool_since or now) if cool else None
        if lc.power_source() == "battery":
            want = lc.AUTO_LOW
        elif current == lc.AUTO_HIGH:
            want = lc.AUTO_LOW if self.cool_since and now - self.cool_since >= self.DOWN_SECONDS else lc.AUTO_HIGH
        elif self.hot_since and now - self.hot_since >= self.UP_SECONDS:
            want = lc.AUTO_HIGH
        else:
            want = lc.AUTO_LOW
        self.state = "boost" if want == lc.AUTO_HIGH else "quiet"
        if want != current and want in lc.profile_choices():
            log("auto: %s -> %s (CPU %.0f °C, GPU %.0f °C)" % (current, want, cpu, gpu))
            self.expect = want
            try:
                lc.set_profile(want)
            except OSError as e:
                log("auto: %s" % e)

    def status(self):
        return {"state": self.state, "cpu": self.cpu, "gpu": self.gpu}


class GuestLimit:
    """Applies the CPU limit a VM's NVIDIA Dynamic Boost asks for.

    lc.set_rapl caps every PL1 write at lc.guest_pl1_cap, so the DTT engine
    only has to rewrite its limits when the cap moves. With DTT not running,
    this class applies the cap on top of the firmware limits itself.
    """
    MIN_W = 15

    def __init__(self):
        self.saved = {}

    def step(self, engine_active):
        cap = lc.guest_cpu_limit()
        if cap is not None:
            cap = max(self.MIN_W, round(cap))
        changed = cap != lc.guest_pl1_cap
        if changed and (cap is None) != (lc.guest_pl1_cap is None):
            log("VM Dynamic Boost: %s" % ("CPU PL1 capped at %d W" % cap if cap else "released"))
        lc.guest_pl1_cap = cap
        if engine_active:
            if self.saved:
                self.saved = {}
            return changed
        if cap is not None and not self.saved:
            for d in lc.RAPL_DOMAINS:
                pl1, pl2 = lc.rapl_limits(d)
                if pl1 and pl2:
                    self.saved[d] = (pl1, pl2)
            changed = True
        if changed and self.saved:
            for d, (pl1, pl2) in self.saved.items():
                try:
                    lc.set_rapl(d, pl1, pl2)
                except OSError as e:
                    log("rapl %s: %s" % (d, e))
            if cap is None:
                self.saved = {}
        return changed

    def restore(self):
        for d, (pl1, pl2) in self.saved.items():
            try:
                lc.set_rapl(d, pl1, pl2)
            except OSError as e:
                log("rapl restore %s: %s" % (d, e))
        self.saved = {}


def stop_thermald():
    if subprocess.run(["systemctl", "is-active", "--quiet", "thermald.service"]).returncode == 0:
        subprocess.run(["systemctl", "stop", "thermald.service"])
        log("stopped thermald: loqd runs the DTT tables itself")


def publish_mode(profile):
    """Tell a VM which power mode the host is in.

    On bare metal a mode change makes the BIOS reload the NVIDIA Dynamic Boost
    limits for that mode (its NVDB, indexed by ODV2) and notify the driver.
    QEMU's isa-batmon serves this byte to the guest, whose NPCF runs the same
    NVDB against the same table, and raises the notify when it changes. The
    byte is the BIOS's ODV2 index, which is DTT's OEM variable 2.
    """
    mode = loqdtt.PROFILE_OEM2.get(profile, 0xFF)
    tmp = lc.GUEST_MODE_FILE + ".tmp"
    try:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
        try:
            os.write(fd, bytes([mode]))
        finally:
            os.close(fd)
        os.replace(tmp, lc.GUEST_MODE_FILE)
    except OSError as e:
        log("guest mode: %s" % e)


def write_status(data):
    os.makedirs(lc.RUN_DIR, exist_ok=True)
    data["guest_cpu_limit"] = lc.guest_pl1_cap
    tmp = lc.THERMAL_STATUS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, lc.THERMAL_STATUS)


def on_profile(cfg, profile):
    publish_mode(profile)
    time.sleep(0.8)
    capture_firmware_curve(profile)
    apply_curve(cfg, profile)


def apply_all(boot):
    cfg = lc.load_config()
    apply_toggles(cfg)
    apply_leds(cfg)
    profile = lc.get_profile()
    publish_mode(profile)
    if boot:
        capture_firmware_curve(profile)
    apply_curve(cfg, profile)
    return profile


def main():
    if not wait_for_hardware():
        log("legion driver or platform profile not present")
    grant()
    os.makedirs(lc.RUN_DIR, exist_ok=True)
    marker = os.path.join(lc.RUN_DIR, "booted")
    boot = not os.path.exists(marker)
    open(marker, "w").close()
    current = apply_all(boot)

    reapply = {"flag": False}

    def hup(*_):
        reapply["flag"] = True

    signal.signal(signal.SIGHUP, hup)

    ppath = lc.profile_path()
    f = open(ppath)
    f.read()
    poller = select.poll()
    poller.register(f.fileno(), select.POLLPRI | select.POLLERR)
    cfg_mtime = os.path.getmtime(lc.CONFIG) if os.path.exists(lc.CONFIG) else 0
    cfg = lc.load_config()
    stop_thermald()
    dtt = loqdtt.DttEngine(log)
    dtt.load()
    guest = GuestLimit()
    auto = AutoMode()
    source = lc.power_source()
    source_changed = 0.0
    last = time.monotonic()

    def shutdown(*_):
        lc.guest_pl1_cap = None
        if dtt.active:
            dtt.restore()
        guest.restore()
        sys.exit(0)

    signal.signal(signal.SIGTERM, shutdown)

    while True:
        try:
            events = poller.poll(1000)
        except InterruptedError:
            events = []
        now = time.monotonic()
        if lc.power_source() != source:
            source = lc.power_source()
            source_changed = now
        if guest.step(dtt.active):
            # The VM moved its CPU cap: have DTT rewrite its limits through it now.
            dtt.last_write_t = 0
        dtt.step(now - last)
        auto.step(cfg, current)
        write_status(dict(dtt.status(), auto=auto.status()))
        last = now
        if events:
            f.seek(0)
            f.read()
        if reapply["flag"]:
            reapply["flag"] = False
            grant()
            if dtt.active:
                dtt.restore()
            current = apply_all(False)
            dtt.capture_base()
            continue
        profile = lc.get_profile()
        if profile != current:
            log("profile %s -> %s" % (current, profile))
            # A change Auto did not make, and not the firmware reacting to the
            # charger, is the user picking a mode (Fn+Q): Auto steps aside.
            if profile == auto.expect:
                auto.expect = None
            elif cfg.get("auto", True) and now - source_changed > 5:
                cfg = lc.load_config()
                cfg["auto"] = False
                lc.save_config(cfg)
                cfg_mtime = os.path.getmtime(lc.CONFIG)
                log("auto: off, %s chosen by hand" % profile)
            current = profile
            on_profile(cfg, profile)
            continue
        m = os.path.getmtime(lc.CONFIG) if os.path.exists(lc.CONFIG) else 0
        if m != cfg_mtime or needs_grant():
            cfg_mtime = m
            cfg = lc.load_config()
            grant()


if __name__ == "__main__":
    main()
