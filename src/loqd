#!/usr/bin/python3
import grp
import json
import os
import select
import signal
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/loq-control")
import loqcommon as lc
import loqdtt


def log(msg):
    print(msg, flush=True)


def grant():
    gid = grp.getgrnam(lc.GROUP).gr_gid
    for p in lc.controlled_paths():
        try:
            os.chown(p, 0, gid)
            mode = 0o640 if p.endswith("energy_uj") else 0o664
            os.chmod(p, mode)
        except OSError as e:
            log("grant %s: %s" % (p, e))
    os.makedirs(lc.STATE_DIR, exist_ok=True)
    os.chown(lc.STATE_DIR, 0, gid)
    os.chmod(lc.STATE_DIR, 0o2775)
    for p in (lc.CONFIG, lc.FIRMWARE_CURVES):
        if os.path.exists(p):
            os.chown(p, 0, gid)
            os.chmod(p, 0o664)


def needs_grant():
    try:
        st = os.stat(os.path.join(lc.LEGION, "fancurve"))
    except OSError:
        return False
    return not st.st_mode & 0o020


def wait_for_hardware(timeout=30):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        if os.path.exists(os.path.join(lc.LEGION, "fancurve")) and os.path.exists(lc.profile_path()):
            return True
        time.sleep(0.5)
    return False


def capture_firmware_curve(profile):
    if not profile:
        return
    curves = lc.load_firmware_curves()
    if profile in curves:
        return
    pts = lc.read_curve()
    if pts:
        curves[profile] = pts
        lc.save_json(lc.FIRMWARE_CURVES, curves)
        log("captured firmware curve for %s" % profile)


def apply_curve(cfg, profile):
    entry = cfg.get("curves", {}).get(profile)
    if not entry or not entry.get("enabled"):
        return
    pts = entry.get("points")
    err = lc.validate_curve(pts or [])
    if err:
        log("curve for %s invalid: %s" % (profile, err))
        return
    for _ in range(5):
        try:
            lc.write_curve(pts)
            if lc.read_curve() == pts:
                log("applied custom curve for %s" % profile)
                return
        except OSError as e:
            log("curve write: %s" % e)
        time.sleep(0.4)


def apply_limits(cfg):
    for name, value in cfg.get("limits", {}).items():
        info = lc.limit_info(name)
        if not info or info["value"] == value:
            continue
        for _ in range(5):
            try:
                lc.set_limit(name, value)
                break
            except OSError:
                time.sleep(0.4)
        else:
            log("limit %s=%s failed" % (name, value))


def apply_toggles(cfg):
    for name, value in cfg.get("toggles", {}).items():
        p = lc.toggle_path(name)
        if p and os.path.exists(p) and lc.read(p) != str(value):
            try:
                lc.write(p, value)
            except OSError as e:
                log("toggle %s: %s" % (name, e))


def apply_leds(cfg):
    for name, value in cfg.get("leds", {}).items():
        p = os.path.join("/sys/class/leds", name, "brightness")
        if os.path.exists(p):
            try:
                lc.write(p, value)
            except OSError as e:
                log("led %s: %s" % (name, e))


class ThermalController:
    KP = 1.6
    KI = 0.25

    def __init__(self):
        self.base = {}
        self.integral = 0.0
        self.temp = None
        self.pl1 = None
        self.active = False
        self.last_write = None
        self.last_time = 0.0
        self.source = None
        self.written = {}

    def capture_base(self):
        self.base = {}
        for d in lc.RAPL_DOMAINS:
            pl1, pl2 = lc.rapl_limits(d)
            if pl1 and pl2:
                self.base[d] = (pl1, pl2)
        self.integral = 0.0
        self.pl1 = None
        self.last_write = None

    def ceiling(self):
        return min(v[0] for v in self.base.values()) / 1e6 if self.base else None

    def restore(self):
        for d, (pl1, pl2) in self.base.items():
            try:
                lc.set_rapl(d, pl1, pl2)
            except OSError as e:
                log("rapl restore %s: %s" % (d, e))
        self.active = False
        self.pl1 = None
        self.last_write = None
        self.status(None)

    def status(self, cfg):
        write_status({"engine": "target", "active": self.active, "pl1": self.pl1, "temp": self.temp,
                      "source": self.source, "ceiling": self.ceiling(), "target": cfg["target"] if cfg else None})

    def step(self, cfg, dt):
        source = lc.power_source()
        if source != self.source:
            if self.source is None:
                self.capture_base()
            else:
                time.sleep(1.0)
                for d in list(self.base):
                    cur = lc.rapl_limits(d)
                    if cur[0] and cur != self.written.get(d):
                        self.base[d] = cur
                self.integral = 0.0
                self.last_write = None
            self.source = source
            log("power source: %s, firmware PL1 %.0f W" % (source, self.ceiling() or 0))
        t = lc.thermal_settings(cfg, source)
        if lc.thermal_mode(cfg) != "target" or not t.get("enabled"):
            if self.active:
                self.restore()
            return
        if not self.base:
            self.capture_base()
        top = self.ceiling()
        if not top:
            return
        raw = lc.cpu_temp()
        if raw is None:
            return
        self.temp = raw if self.temp is None else self.temp * 0.6 + raw * 0.4
        target = float(t.get("target", 82))
        lo = float(t.get("min_watts", 20))
        err = target - self.temp
        self.integral = max(-(top - lo) / self.KI, min(0.0, self.integral + err * dt))
        want = max(lo, min(top, top + self.KP * err + self.KI * self.integral))
        self.pl1 = want
        self.active = True
        w = int(round(want))
        now = time.monotonic()
        if w != self.last_write or now - self.last_time > 10:
            self.last_time = now
            for d, (b1, b2) in self.base.items():
                pl1 = min(b1, w * 1000000)
                pl2 = min(b2, max(pl1, int((w + max(15, w * 0.4)) * 1e6)))
                try:
                    lc.set_rapl(d, pl1, pl2)
                    self.written[d] = (pl1, pl2)
                except OSError as e:
                    log("rapl %s: %s" % (d, e))
            self.last_write = w
        self.status(t)


def stop_thermald():
    if subprocess.run(["systemctl", "is-active", "--quiet", "thermald.service"]).returncode == 0:
        subprocess.run(["systemctl", "stop", "thermald.service"])
        log("stopped thermald: loqd runs the DTT tables itself")


def write_status(data):
    os.makedirs(lc.RUN_DIR, exist_ok=True)
    tmp = lc.THERMAL_STATUS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, lc.THERMAL_STATUS)


def on_profile(cfg, profile):
    time.sleep(0.8)
    capture_firmware_curve(profile)
    if profile == "custom":
        apply_limits(cfg)
    apply_curve(cfg, profile)


def apply_all(boot):
    cfg = lc.load_config()
    apply_toggles(cfg)
    apply_leds(cfg)
    if boot and cfg.get("restore_profile") and cfg.get("profile") in lc.profile_choices():
        if lc.get_profile() != cfg["profile"]:
            capture_firmware_curve(lc.get_profile())
            lc.set_profile(cfg["profile"])
            time.sleep(0.8)
    profile = lc.get_profile()
    if boot:
        capture_firmware_curve(profile)
    if profile == "custom":
        apply_limits(cfg)
    apply_curve(cfg, profile)
    return profile


def main():
    if not wait_for_hardware():
        log("legion driver or platform profile not present")
    grant()
    os.makedirs(lc.RUN_DIR, exist_ok=True)
    marker = os.path.join(lc.RUN_DIR, "booted")
    boot = not os.path.exists(marker)
    open(marker, "w").close()
    current = apply_all(boot)

    reapply = {"flag": False}

    def hup(*_):
        reapply["flag"] = True

    signal.signal(signal.SIGHUP, hup)

    ppath = lc.profile_path()
    f = open(ppath)
    f.read()
    poller = select.poll()
    poller.register(f.fileno(), select.POLLPRI | select.POLLERR)
    cfg_mtime = os.path.getmtime(lc.CONFIG) if os.path.exists(lc.CONFIG) else 0
    thermal = ThermalController()
    thermal.capture_base()
    cfg = lc.load_config()
    stop_thermald()
    dtt = loqdtt.DttEngine(log)
    dtt.load()
    last = time.monotonic()

    def shutdown(*_):
        if thermal.active:
            thermal.restore()
        if dtt.active:
            dtt.restore()
        sys.exit(0)

    signal.signal(signal.SIGTERM, shutdown)

    while True:
        try:
            events = poller.poll(1000)
        except InterruptedError:
            events = []
        now = time.monotonic()
        mode = lc.thermal_mode(cfg)
        if mode == "dtt":
            if thermal.active:
                thermal.restore()
            dtt.step(now - last)
            write_status(dtt.status())
        else:
            if dtt.active:
                dtt.restore()
                write_status({"engine": mode, "active": False})
            thermal.step(cfg, now - last)
        last = now
        if events:
            f.seek(0)
            f.read()
        if reapply["flag"]:
            reapply["flag"] = False
            grant()
            if thermal.active:
                thermal.restore()
            if dtt.active:
                dtt.restore()
            current = apply_all(False)
            thermal.capture_base()
            dtt.capture_base()
            continue
        profile = lc.get_profile()
        if profile != current:
            log("profile %s -> %s" % (current, profile))
            current = profile
            if thermal.active:
                thermal.restore()
            on_profile(lc.load_config(), profile)
            thermal.capture_base()
            continue
        m = os.path.getmtime(lc.CONFIG) if os.path.exists(lc.CONFIG) else 0
        if m != cfg_mtime or needs_grant():
            cfg_mtime = m
            cfg = lc.load_config()
            if thermal.active and lc.thermal_mode(cfg) != "target":
                thermal.restore()
            grant()


if __name__ == "__main__":
    main()
